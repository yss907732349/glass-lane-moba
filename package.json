{
  "name": "glass-lane",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "透明单线 · 桌面联机MOBA",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server:dev": "node --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=build/server.cjs --external:ws",
    "start": "node build/server.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:terrain": "node scripts/terrain-playtest.mjs",
    "test:browser": "node scripts/playtest.mjs",
    "desktop": "electron .",
    "pack": "pnpm build && electron-builder --win nsis portable --x64",
    "test:native": "node scripts/native-hidden-smoke.mjs",
    "test:rooms": "node scripts/room-connection-playtest.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "esbuild": "^0.27.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "@playwright/test": "^1.57.0"
  },
  "build": {
    "appId": "friends.glass.lane",
    "productName": "透明单线",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "desktop/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "GlassLane-${version}-Portable.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "GlassLane-${version}-Setup.${ext}"
    }
  }
}
